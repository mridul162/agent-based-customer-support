#############################################################
# Application
#############################################################

APP_ENV=development

#############################################################
# OpenAI
#############################################################

OPENAI_API_KEY=your_openai_api_key

OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

#############################################################
# PostgreSQL
#############################################################

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_support
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Optional
# If DATABASE_URL is provided, it overrides the fields above.
DATABASE_URL=

#############################################################
# RAG
#############################################################

KNOWLEDGE_BASE_PATH=knowledge_base

RAG_ARTIFACTS_PATH=artifacts
CHUNK_ARTIFACTS_PATH=artifacts/chunked

FAISS_INDEX_PATH=artifacts/embeddings/index.faiss
FAISS_METADATA_PATH=artifacts/embeddings/metadata.json
MANIFEST_PATH=artifacts/embeddings/manifest.json